# Copy this file to ".env" and change the values.  (".env" is ignored by git.)

# Password for the admin dashboard at /admin  — CHANGE THIS
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin login tokens. Any long random text.
# If you leave it out, admins have to log in again every time the server restarts.
JWT_SECRET=put-a-long-random-string-here

# Optional
# PORT=3000
# MAX_PER_SLOT=3          # bookings allowed per date + time slot
# MAX_OPEN_PER_PHONE=5    # open bookings one customer can hold at once
# TIMEZONE=Asia/Kolkata
# DB_FILE=./bookings.json # on Render, point this to a persistent disk path

# Super Admin password (stock, workers, attendance, salary, turnover) at /manage — CHANGE THIS
SUPER_PASSWORD=change-me-too
